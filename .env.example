KLIPY_API_KEY=your_klipy_api_key_here

# Cloudflare Web Analytics site token (cookieless, GDPR-friendly).
# Get from Cloudflare dashboard → Analytics & Logs → Web Analytics → site → "JS snippet" (the value of data-cf-beacon's "token" field).
# Leave blank in dev — the beacon only loads in production builds.
CLOUDFLARE_ANALYTICS_TOKEN=
